# Copy this file to server/.env and fill in the values. server/.env is never committed.
# Never paste these values into a chat or a commit.

# Supabase (production project) -> Connect -> "Session pooler" connection string, with your DB password.
DATABASE_URL=

# A SECOND Supabase project used only by the tests -> "Session pooler" string. Tests never use DATABASE_URL.
TEST_DATABASE_URL=

# "verify" (default when empty): SSL with Supabase's CA certificate. "off": only for the CI Postgres container.
DATABASE_SSL=

# Long random string for signing login tokens (from the auth step). Generate it in a separate terminal.
JWT_SECRET=

# Anthropic (Phase 2). The key is secret; the model name is not.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Local port for the API (Render sets its own).
PORT=3000
