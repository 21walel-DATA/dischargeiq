{
  "name": "@dischargeiq/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "DischargeIQ REST API (Express + TypeScript).",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env index.ts",
    "build": "tsup",
    "start": "node dist/index.js",
    "typecheck": "tsc -p .",
    "test": "vitest run",
    "migrate": "tsx --env-file-if-exists=.env db/migrate.ts",
    "seed": "tsx --env-file-if-exists=.env db/seed.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.9.0",
    "@dischargeiq/shared": "*",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "express": "^5.1.0",
    "express-rate-limit": "^8.7.4",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.16.0",
    "swagger-ui-dist": "^5.35.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.0",
    "@types/supertest": "^6.0.3",
    "supertest": "^7.1.0",
    "tsup": "^8.5.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^4.1.12"
  }
}
